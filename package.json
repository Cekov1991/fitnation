{
  "name": "fit-nation",
  "private": true,
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build:web": "pnpm --filter web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter web exec tsc --noEmit && pnpm --filter mobile exec tsc --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
